extends "res://tests/test_case.gd"
## Experiment 009 (lead): the user's scenarios A–H through the real game
## scene where practical (the agents' own files cover the details).
## A daily opportunities · B on demand · C residential · D commercial and the
## stash · E apartment · F dormant psycho · G persistence · H loading.

const SCENE := "res://src/game/game.tscn"
const SAVE := "user://test_e9_scenarios.dat"
const TravelFlow := preload("res://src/travel/travel_flow.gd")


func _boot(mode: String) -> Node:
	SaveGame.path_override = SAVE
	GameLaunch.mode = mode
	GameLaunch.seed = 9009
	var g: Node = (load(SCENE) as PackedScene).instantiate()
	g.stay_in_scene = true
	g.skip_intro = true
	g.fade_time = 0.02
	g.death_delay = 0.05
	g.aim_with_mouse = false
	add(g)
	tree.current_scene = g
	await frames(3)
	return g


func _next_scene(g: Node) -> Node:
	check(g.left_to == GameLaunch.GAME_SCENE, "changes scene (left_to '%s')" % g.left_to)
	g.queue_free()
	await frames(2)
	return await _boot(GameLaunch.mode)


func _wait_until(cond: Callable, max_frames: int) -> bool:
	for i in max_frames:
		if cond.call():
			return true
		await frames(1)
	return cond.call()


func cleanup() -> void:
	tree.paused = false
	if SaveGame.path_override == SAVE:
		SaveGame.delete_save()
	SaveGame.path_override = ""
	GameLaunch.mode = "new"
	GameLaunch.seed = 0
	GameLaunch.site = "home"
	GameLaunch.carry = {}
	TravelFlow.skip_animation = false
	await super.cleanup()


func _go(g: Node, id: String) -> Node:
	g.state.region.discover(id)
	DailySites.force_available(g.state, id)
	var why: String = await g.travel.depart(id)
	check_eq(why, "", "sets out for %s" % id)
	return await _next_scene(g)


func _home(g: Node) -> Node:
	g.debug_kill_enemies()
	g.leave_site()
	if g.poi != null and g.poi.leave_dialog != null and g.poi.leave_dialog.visible:
		g.poi.leave_dialog.choose("home")
	await _wait_until(func(): return g.left_to != "", 60)
	return await _next_scene(g)


## A: two consecutive days; the selection may change, overrun sites keep
## their identity (archetype and seed).
func test_a_daily_opportunities() -> void:
	var s := GameState.new_run(9009)
	for id in RegionLocations.ids():
		s.region.discover(id)
	s.total_minutes = 1440.0 + 9.0 * 60.0          # day 2 (day 1 has every known place open)
	var d2 := DailySites.refresh(s, 2)
	var a2: Array = DailySites.available_ids(s).duplicate()
	var setups := {}
	for id in RegionLocations.ids():
		setups[id] = DailySites.setup(s, id)
	s.total_minutes += 1440.0
	DailySites.refresh(s, 3)
	var a3: Array = DailySites.available_ids(s)
	check(a2.size() >= 4 and a2.size() <= 6 and a3.size() >= 4 and a3.size() <= 6, "4–6 open each day (%d, %d)" % [a2.size(), a3.size()])
	check(a2 != a3 or d2.is_empty(), "the selection can change from one day to the next (%s -> %s)" % [a2, a3])
	var over: Array = DailySites.overrun_ids(s)
	check(not over.is_empty(), "some places are overrun")
	for id in over:
		var su := DailySites.setup(s, id)
		check_eq(su["archetype"], setups[id]["archetype"], "%s keeps its archetype while overrun" % id)
		check_eq(int(su["seed"]), int(setups[id]["seed"]), "%s keeps its seed" % id)
		check(TravelRules.block_reason(s, id).contains("Overrun"), "%s can't be visited today" % id)


## B, C, G: nothing is generated by opening the map; travelling to a family
## house generates it once; it is the same house after leaving, a save and
## Continue, and what was taken stays taken.
func test_bcg_on_demand_residential_and_persistence() -> void:
	TravelFlow.skip_animation = true
	PoiDefs._cache.clear()
	var g: Node = await _boot("new")
	g.state.total_minutes = 9.0 * 60.0
	g.debug_open("map")
	await frames(3)
	var gen_cached := PoiDefs._cache.keys().filter(func(k): return PoiDefs.is_generated(str(k)))
	check(gen_cached.is_empty(), "B: opening the map generates nothing (%s)" % [gen_cached])
	g.debug_close()
	await frames(1)
	g = await _go(g, "cul_de_sac")
	check(not g.is_home() and g.site_id() == "cul_de_sac", "at the cul-de-sac")
	var L: Dictionary = g.world.layout
	check_eq(str(L.get("archetype", "")), "house_family", "C: a family house")
	var kinds := {}
	for r in g.world.rooms():
		kinds[str(r.get("type", r["id"]))] = true
	print("E9 rooms: ", kinds.keys(), " props ", (L["props"] as Array).size(), " containers ", (L["containers"] as Array).size())
	check(g.world.rooms().size() >= 4, "C: several rooms (%d)" % g.world.rooms().size())
	check((L["containers"] as Array).size() >= 6, "C: things to search")
	check(str(L.get("stash", "")) != "", "C: a main stash")
	check(bool(PoiGenerator.validate(L).get("ok", false)), "C: the layout validates")
	# take something
	var taken_id := ""
	var taken := {}
	for sp in g.world.spots_of("container"):
		var items: Dictionary = g.poi.record["c"][sp.id]["items"]
		if str(sp.data.get("needs", "")) == "" and not items.is_empty():
			g.debug_teleport_player(sp.plan_pos() + sp.front * 0.75)
			await physics_frames(2)
			g.poi.interact_spot(sp)
			await frames(1)
			g.poi.complete_action()
			taken = g.poi.panel.take_everything()
			g.poi.close_panel()
			taken_id = sp.id
			break
	check(taken_id != "" and not taken.is_empty(), "took something (%s)" % [taken])
	var ids_before := (L["containers"] as Array).map(func(c): return str(c["id"]))
	var walls_before := (L["walls"] as Array).size()
	g = await _home(g)
	check(g.is_home(), "home")
	check_eq(g.debug_save(), "", "saved at home")
	g.queue_free()
	await frames(2)
	PoiDefs._cache.clear()                  # nothing kept in memory: the record alone rebuilds it
	g = await _boot("continue")
	g = await _go(g, "cul_de_sac")
	var L2: Dictionary = g.world.layout
	check_eq((L2["containers"] as Array).map(func(c): return str(c["id"])), ids_before, "G: the same containers on the revisit")
	check_eq((L2["walls"] as Array).size(), walls_before, "G: the same walls")
	var box: Dictionary = g.poi.record["c"][taken_id]
	check(bool(box["searched"]), "G: the searched one is still searched")
	for id in taken:
		check_eq(int((box["items"] as Dictionary).get(id, 0)), 0, "G: %s didn't come back" % id)


## D: a supermarket has shop furniture and exactly one stash; the stash is
## never refilled.
func test_d_commercial_and_the_stash() -> void:
	var s := GameState.new_run(9009)
	var d := PoiDefs.get_def("grocery", s)
	var L: Dictionary = d["layout"]
	check_eq(str(L.get("archetype", "")), "supermarket", "the grocery is a supermarket")
	var stashes := (L["containers"] as Array).filter(func(c): return bool(c.get("stash", false)))
	check_eq(stashes.size(), 1, "exactly one main stash")
	var types := {}
	for p in L["props"]:
		types[str(p["type"])] = true
	for c in L["containers"]:
		types[str(c["type"])] = true
	check(types.has("shelves") or types.has("pallet_rack"), "shop shelving (%s)" % [types.keys()])
	check(not types.has("bed") and not types.has("sofa"), "no beds or sofas on a shop floor")
	var r := PoiState.record(s, "grocery")
	PoiState.generate(s, "grocery", r)
	var sid := str(L["stash"])
	r["c"][sid]["items"] = {}
	r["c"][sid]["searched"] = true
	PoiState.replenish(s, "grocery", r, s.day() + 30)
	check(FurnitureStorage.total(r["c"][sid]["items"]) == 0, "a looted stash stays empty a month later")


## E: the apartment: a hallway that ends in darkness, the question asked once.
func test_e_apartment_and_the_dark_exit() -> void:
	TravelFlow.skip_animation = true
	var g: Node = await _boot("new")
	g.state.total_minutes = 10.0 * 60.0
	g = await _go(g, "apartments")
	var L: Dictionary = g.world.layout
	check_eq(str(L.get("archetype", "")), "apartment", "an apartment")
	check(L.get("dark_exit") is Rect2, "the hallway ends in darkness")
	g.debug_kill_enemies()
	var r: Rect2 = L["dark_exit"]
	g.debug_teleport_player(r.get_center())
	for i in 30:
		await physics_frames(1)
		if g.poi.leave_dialog.visible:
			break
	check(g.poi.leave_dialog.visible, "walking into the dark asks to leave")
	g.poi.leave_dialog.choose("stay")
	await frames(10)
	check(not r.has_point(g.debug_player_pos()), "Stay steps Eli back out")
	check(not g.poi.leave_dialog.visible, "and the question doesn't come again at once")


## F: a dormant psycho in a generated building wakes to a gunshot and hunts.
func test_f_dormant_psycho_wakes() -> void:
	TravelFlow.skip_animation = true
	var g: Node = await _boot("new")
	g.state.total_minutes = 10.0 * 60.0
	g = await _go(g, "workshop")
	g.debug_kill_enemies()
	var txt: String = g.poi.dev_spawn_dormant("sway")
	check(txt != "" and not txt.begins_with("No"), "F10 places a dormant psycho (%s)" % txt)
	var e: AIEnemy = null
	for w in g.poi.watch:
		if is_instance_valid(w["e"]) and str(w["mode"]) == "dormant":
			e = w["e"]
	if not check(e != null, "a dormant one is watched"):
		return
	var far: Vector2 = g.world.entry_point()
	for p in g.world.exit_points():
		if p.distance_to(e.plan_pos()) > far.distance_to(e.plan_pos()):
			far = p
	g.debug_teleport_player(far)               # Eli steps well away at once
	await frames(90)
	check(e.is_calm() and e.mind is DormantMind, "it doesn't notice Eli across the place (%.1f m)" % far.distance_to(e.plan_pos()))
	var at: Vector2 = e.plan_pos() + Vector2(2.5, 0)
	g.debug_teleport_player(at)
	await physics_frames(2)
	NoiseEvent.emit(g, Vector3(at.x, 1.0, at.y), 4.0, "gunfire")
	var woke := await _wait_until(func(): return not is_instance_valid(e) or not e.is_calm(), 600)
	check(woke, "a gunshot beside it wakes it into the ordinary AI")


## H: arriving with the loading screen: progress rises and the scene keeps
## drawing between stages.
func test_h_loading_progress_for_a_generated_site() -> void:
	PoiDefs._cache.clear()
	var s := GameState.new_run(9009)
	var ctx: Object = PoiDefs.begin_def("hospital", s)
	check(ctx != null, "a stepped generation context")
	var last := -1.0
	var steps := 0
	var stages := {}
	while not ctx.step():
		steps += 1
		check(float(ctx.progress) >= last, "progress never goes back")
		last = float(ctx.progress)
		stages[str(ctx.stage)] = true
		if steps > 500:
			break
	check(steps >= 4, "several steps (%d) the screen can draw between" % steps)
	check(stages.size() >= 3, "named stages (%s)" % [stages.keys()])
	check(not PoiDefs.get_def("hospital", s).is_empty(), "the finished place is cached for the arrival")
