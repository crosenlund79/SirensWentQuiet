; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sirens Went Quiet"
config/description="Visual Technology Experiment 001: three ways to build a destructible house."
config/version="0.1.0-exp001"
run/main_scene="res://src/launcher/launcher.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
toggle_day_night={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":78)]
}
reset_level={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
back_to_launcher={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
toggle_help={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72), Object(InputEventKey,"physical_keycode":4194332)]
}
toggle_stats={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}
zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4), Object(InputEventKey,"physical_keycode":61), Object(InputEventKey,"physical_keycode":4194437)]
}
zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5), Object(InputEventKey,"physical_keycode":45), Object(InputEventKey,"physical_keycode":4194435)]
}

[layer_names]

2d_physics/layer_1="environment"
2d_physics/layer_2="walls"
2d_physics/layer_3="player"
2d_physics/layer_4="enemies"
2d_physics/layer_5="low_obstacles"
3d_physics/layer_1="environment"
3d_physics/layer_2="walls"
3d_physics/layer_3="player"
3d_physics/layer_4="enemies"
